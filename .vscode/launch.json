{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CMake target (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${command:cmake.launchTargetDirectory}"
        },
        {
            "name": "Debug CMake target (macOS)",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${command:cmake.launchTargetDirectory}"
        },
        {
            "name": "(ctest) Launch (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "presentation": { "hidden": true },
            "program": "${cmake.testProgram}",
            "args": ["${cmake.testArgs}"],
            "cwd": "${cmake.testWorkingDirectory}"
        },
        {
            "name": "(ctest) Launch (macOS)",
            "type": "lldb",
            "request": "launch",
            "presentation": { "hidden": true },
            "program": "${cmake.testProgram}",
            "args": ["${cmake.testArgs}"],
            "cwd": "${cmake.testWorkingDirectory}"
        }
    ]
}
